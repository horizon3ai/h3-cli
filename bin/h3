#!/bin/bash
#
# usage: h3 <subcommand> [args...]
#
# For details on any subcommand:
#   h3 <subcommand> --help
#   h3 help <subcommand>
#
# For verbose tracing: export H3_CLI_VERBOSE=1
#

# bootstrap PATH if needed
function bootstrap_path {
    if ! command -v h3-env &> /dev/null; then
        if [ -n "$BASH_SOURCE" ]; then s="$BASH_SOURCE"; else s="$0"; fi
        d=`dirname "$s"`
        rc=$?
        if [ $rc -eq 0 ]; then
            PATH="$d:$PATH"
        fi
    fi
}
bootstrap_path


# writes message to stderr
# usage: echoerr "the message"
function echoerr {
    echo "[`date`] $*" 1>&2;
}


# writes message to stderr
# usage: echolog "the message"
function echolog {
    if [ "$verbose" = "x" ]; then
        echo "[`date`] $*" 1>&2;
    fi
}


# -----------------------------------------------------------
# Inline commands.
#
# Most subcommands live in their own bin/h3-<cmd> file and are
# delegated to below.  These few stay inline because they either
# collide with an internal file name (env, start-agent) or must
# run in the caller's shell (profile, via '. h3 profile <name>').
#
# Their help lives in named `# @help <cmd>` blocks below (rendered
# by bin/h3-help, which reads them out of this file).
# -----------------------------------------------------------

# @help env
#
# h3-env: Show the h3-cli environment configuration.
#
# Usage:
#     h3 env
#
# Description:
#     Resolves and prints the environment variables that h3-cli uses, including
#     the active profile, API key, API URLs, install dir, and logging dir.
#
#     These can be overridden by exporting the corresponding environment variable
#     or by setting it in the active profile under ~/.h3.
#
function cmd_env {
    source h3-utils
    ensure_H3_CLI_PROFILES_DIR
    ensure_H3_CLI_LOGGING_DIR
    ensure_H3_CLI_RUN_CONTAINER_OUTPUT_DIR
    ensure_H3_API_KEY
    ensure_H3_CLI_HOME
    ensure_H3_AUTH_URL
    ensure_H3_GQL_URL
    ensure_H3_CLI_GQL_PATH
    echo "H3_CLI_HOME=$H3_CLI_HOME"
    echo "H3_CLI_PROFILES_DIR=$H3_CLI_PROFILES_DIR"
    echo "H3_CLI_PROFILE=$H3_CLI_PROFILE"
    echo "H3_CLI_GQL_PATH=$H3_CLI_GQL_PATH"
    echo "H3_API_KEY=$H3_API_KEY"
    echo "H3_AUTH_URL=$H3_AUTH_URL"
    echo "H3_GQL_URL=$H3_GQL_URL"
    # hide this option for now.  users should set the system-level http_proxy env var.
    if [ -n "$H3_CLI_PROXY_URL" ]; then
        echo "H3_CLI_PROXY_URL=$H3_CLI_PROXY_URL"
    fi
    echo "H3_CLI_LOGGING_DIR=$H3_CLI_LOGGING_DIR"
    echo "H3_CLI_RUN_CONTAINER_OUTPUT_DIR=$H3_CLI_RUN_CONTAINER_OUTPUT_DIR"
}


# @help profile
#
# h3-profile: Show or set the current h3-cli profile.
#
# Usage:
#     h3 profile
#     . h3 profile <profile-name>
#
# Description:
#     With no argument, prints the name of the current profile.
#
#     To SET the current profile, <profile-name> must be given AND the command must
#     run in the current shell -- prefix it with 'source' or '.' -- so the exported
#     H3_CLI_PROFILE persists after the command returns:
#
#         . h3 profile <profile-name>
#         source h3 profile <profile-name>
#
#     Equivalently, export the profile yourself:
#
#         export H3_CLI_PROFILE=<profile-name>; h3 auth force
#
#     Profiles (API keys) are stored under ~/.h3.  See also: h3 profiles, h3 save-profile.
#
# Options:
#     <profile-name>   Set the current profile to the given name.
#
function cmd_profile {
    set_profile=$1
    if [ -n "$set_profile" ]; then
        export H3_CLI_PROFILE=$set_profile
        jwt=`h3-auth force`
    fi
    source h3-utils
    ensure_H3_CLI_PROFILE
    echo $H3_CLI_PROFILE
}


# @help start-agent
#
# h3-start-agent: Run a NodeZero Runner as a background process.
#
# Usage:
#     h3 start-runner <name> [log-file]
#     h3 start-agent <name> [log-file]
#
# Description:
#     Launches a NodeZero Runner (agent) as a detached background process on this
#     machine and registers it under the given <name>.  The Runner polls the API
#     for queued commands (eg. scheduled pentests) and executes them locally.
#
#     To run the Runner as a systemd service instead, use: h3 start-runner-service
#
# Options:
#     <name>       The name to assign to this Runner.  Required.
#     [log-file]   Where to write logs.  Defaults to $H3_CLI_LOGGING_DIR/<name>.log
#                  (<name> is slugified).
#
# See also:
#     h3 runners, h3 tail-runner, h3 stop-runner, h3 start-runner-service
#
function cmd_start_agent {
    source h3-env
    agent_name=$1
    log_file=$2
    if [ -z "$agent_name" ]; then
        echoerr "ERROR: runner_name is required"
        return 1
    fi
    if [ -z "$log_file" ]; then
        agent_name_slug=`slugify "$agent_name"`
        log_file="$H3_CLI_LOGGING_DIR/$agent_name_slug.log"
    fi
    pkill_agent "$agent_name"
    # echoerr "Starting NodeZero Runner via: nohup h3-start-agent \"$agent_name\" < /dev/null >> \"$log_file\" 2>&1 &"
    echoerr "INFO: Starting NodeZero Runner $agent_name, logging to $log_file ..."
    # NOTE: this command is dup'ed in h3 and h3-start-agent.
    nohup h3-start-agent "$agent_name" "$log_file" < /dev/null >> "$log_file" 2>&1 &
    rc=$?
    if [ $rc -eq 0 ]; then
        ps_agent
        echoerr "INFO: Stream the NodeZero Runner logs via: h3 tail-runner \"$agent_name\" "
        if is_systemd_running; then
            echoerr "INFO: To register the NodeZero Runner with systemd, use: h3 start-runner-service \"$agent_name\" "
        fi
    fi
    return $rc
}


# -----------------------------------------------------------
# --help handling.
#
# The overview and the per-command `# @help` block rendering live in
# bin/h3-help, which the help paths below invoke as a subprocess.  Running
# it in a subprocess means help can never 'exit' this shell -- important on
# the sourced '. h3 ...' path -- and keeps this script light.
# -----------------------------------------------------------

# true if any arg is --help or -h
function help_requested {
    for a in "$@"; do
        if [ "$a" = "--help" -o "$a" = "-h" ]; then
            return 0
        fi
    done
    return 1
}


# -----------------------------------------------------------
# read and normalize the subcommand
# -----------------------------------------------------------
cmd=$1
shift
cmd=`h3-map-cmd "$cmd"`


# -----------------------------------------------------------
# Detect being sourced (eg. '. h3 profile <name>').  On the help
# paths below we must not 'exit' when sourced -- that would kill the
# caller's shell.  When sourced we 'return' (which unwinds the sourced
# script) instead of 'exit'.  This must be done inline at the script's
# top level: a 'return' inside a function would only return from that
# function, not stop the sourced script.
# -----------------------------------------------------------
if [ "${BASH_SOURCE[0]}" != "$0" ]; then _H3_SOURCED=1; fi


# -----------------------------------------------------------
# top-level help:  h3  /  h3 help [subcommand]  /  h3 --help  /  h3 -h
# -----------------------------------------------------------
if [ -z "$cmd" -o "$cmd" = "help" -o "$cmd" = "--help" -o "$cmd" = "-h" ]; then
    h3-help "$1"
    rc=$?
    if [ -n "$_H3_SOURCED" ]; then return $rc; else exit $rc; fi
fi


# -----------------------------------------------------------
# per-subcommand help:  h3 <subcommand> --help
# NOTE: this is reached for '. h3 profile --help', so it must not
# 'exit' when sourced -- see the sourced guard above.  h3-help is a
# subprocess, so it can exit freely without touching the caller's shell.
# -----------------------------------------------------------
if help_requested "$@"; then
    h3-help "$cmd"
    rc=$?
    if [ -n "$_H3_SOURCED" ]; then return $rc; else exit $rc; fi
fi


# -----------------------------------------------------------
# run the subcommand
# -----------------------------------------------------------
if [ "$cmd" = "env" ]; then
    cmd_env "$@"

elif [ "$cmd" = "profile" ]; then
    # NOTE: no 'exit' on this path -- it is commonly run as '. h3 profile <name>'
    # so that the exported H3_CLI_PROFILE persists in the caller's shell.
    cmd_profile "$@"

elif [ "$cmd" = "start-agent" ]; then
    cmd_start_agent "$@"

else
    # delegate to the bin/h3-<cmd> file
    source h3-utils
    assert_H3_CLI_HOME
    if [ -f "$H3_CLI_HOME/bin/h3-$cmd" ]; then
        "$H3_CLI_HOME/bin/h3-$cmd" "$@"
    else
        echoerr "ERROR: unrecognized command: \"$cmd\".  Run \"h3 help\" for usage info."
        exit 1
    fi
fi
