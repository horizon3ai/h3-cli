#!/bin/bash
#
# Fetch a specific agent.
#
# usage: h3-agent {agent-name}
#

# @help
#
# h3-agent: Show the NodeZero Runner with the given name.
#
# Usage:
#     h3 runner <name>
#     h3 agent <name>
#
# Description:
#     Fetches the NodeZero Runner (a.k.a. agent) registered with the given
#     <name> and prints its details as JSON. In this product, "Runner" and
#     "agent" are the same thing.
#
# Options:
#     <name>   Name of the Runner to look up (required).
#
# See also:
#     h3 agents, h3 agent-commands, h3 tail-agent
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
agent_name=$1
if [ -z "$agent_name" ]; then
    echoerr "name is required"
    exit 1
fi

# 2.
# call GQL
json_params=`cat <<HERE
{"name":"$agent_name"}
HERE
`
res=`h3-gql agent "$json_params"`
rc=$?
if [ $rc -eq 0 ]; then 
    cat <<<$res | jq '.data.agent'
else 
    echo "$res"; 
    exit $rc
fi

