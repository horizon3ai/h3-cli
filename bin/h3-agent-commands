#!/bin/bash
#
# Fetch a specific agent and its commands.
#
# usage: h3-agent-commands {agent-name}
#

# @help
#
# h3-agent-commands: Show the Runner with the given name and the last commands it ran.
#
# Usage:
#     h3 runner-commands <name>
#     h3 agent-commands <name>
#
# Description:
#     Fetches the NodeZero Runner (a.k.a. agent) with the given <name> along
#     with the most recent commands it has run, and prints the result as JSON.
#
# Options:
#     <name>   Name of the Runner to look up (required).
#
# See also:
#     h3 agent, h3 agents
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
agent_name=$1
if [ -z "$agent_name" ]; then
    echoerr "name is required"
    exit 1
fi

# 2.
# call GQL
json_params=`cat <<HERE
{"name":"$agent_name"}
HERE
`
res=`h3-gql agent_commands "$json_params"`
rc=$?
if [ $rc -eq 0 ]; then 
    cat <<<$res | jq '.data.agent'
else 
    echo "$res"; 
    exit $rc
fi

