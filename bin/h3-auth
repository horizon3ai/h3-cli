#!/bin/bash
#
# usage:
#
# h3-auth           # read cached jwt file if exists
# h3-auth force     # force re-auth
#
#

# @help
#
# h3-auth: Authenticate to the H3 API using the current profile's API key.
#
# Usage:
#     h3 auth [force]
#
# Description:
#     Obtains a JWT for the active profile and prints it to STDOUT.
#     With no argument, returns the cached JWT (from the H3_API_JWT env var
#     or the profile's .jwt file) if one exists, otherwise authenticates.
#     'force' always re-authenticates against H3_AUTH_URL, ignoring any
#     cached JWT. If the profile's configured endpoint fails, auth falls
#     back through the regional endpoints (EU, then AU) and, on success,
#     redirects the profile to that region.
#
# Options:
#     force   Re-authenticate even if a cached JWT exists.
#
# See also:
#     h3 gql
#

# pull in env vars and util fns
source h3-env 

# JWT is stored here
jwt_file="$H3_CLI_PROFILES_DIR/$H3_CLI_PROFILE.jwt"


# @returns json response: {"token":"..."}
function gen_jwt {
    if [ "$H3_AUTH_URL" = "sandbox" ]; then
        echo '{"token":"sandbox"}'
        return 0
    fi
    run_curl -s -S \
      -X POST $H3_AUTH_URL \
      -H 'Content-Type: application/json' \
      -d @- <<HERE 
{
    "key": "$H3_API_KEY"
}
HERE
}

# Authenticate against a specific regional endpoint. On success, persist the
# region URLs to the profile and return 101 to signal a redirect -- the caller
# (h3-gql) reloads the profile on 101 so the new URLs take effect in the current
# invocation. On failure, leave the region URLs in place and return curl's rc so
# refresh_jwt_with_fallback can try the next region.
# usage: try_region <REGION_NAME> <auth_url> <gql_url>
function try_region {
    local region="$1"
    H3_AUTH_URL="$2"
    H3_GQL_URL="$3"

    refresh_jwt
    rc=$?
    if [ $rc -ne 0 ]; then
        return $rc
    fi

    # save the region URLs in the profile
    profile="$H3_CLI_PROFILES_DIR/$H3_CLI_PROFILE.env"
    cat <<HERE >> "$profile"
H3_AUTH_URL=$H3_AUTH_URL
H3_GQL_URL=$H3_GQL_URL
HERE
    # signal the caller to reload the profile so the new URLs are picked up
    echoerr "INFO: REDIRECTED TO $region: Your profile has been redirected to our $region region."
    return 101
}


# Authenticate against the profile's configured endpoint; if that fails, fall
# back through the regional endpoints (EU, then AU) in turn. The terminal
# "Authentication Failed" error is emitted only once, after EVERY endpoint has
# failed -- so a user who is ultimately redirected to a region never sees a
# scary error on an auth that actually succeeds.
# :returns: 0 (configured endpoint worked), 101 (redirected to a region), or
#           curl's non-zero rc (all endpoints failed).
function refresh_jwt_with_fallback {
    # 1. try the profile's configured URLs
    refresh_jwt
    rc=$?
    if [ $rc -eq 0 ]; then
        return 0
    fi

    # 2. fall back through the regional endpoints. Remember the configured URLs
    #    so we can restore them if none of the regions work.
    local orig_auth_url="$H3_AUTH_URL"
    local orig_gql_url="$H3_GQL_URL"

    try_region EU https://api.horizon3ai.eu/v1/auth https://api.horizon3ai.eu/v1/graphql
    rc=$?
    if [ $rc -eq 101 ]; then
        return 101
    fi

    try_region AU https://api.horizon3ai.au/v1/auth https://api.horizon3ai.au/v1/graphql
    rc=$?
    if [ $rc -eq 101 ]; then
        return 101
    fi

    # every endpoint failed -- restore the configured URLs and report once
    H3_AUTH_URL="$orig_auth_url"
    H3_GQL_URL="$orig_gql_url"
    echoerr "ERROR: Authentication Failed. For more details, enable verbose logging (export H3_CLI_VERBOSE=1) and retry."
    return $rc
}


function refresh_jwt {
    echolog "authenticating to H3_AUTH_URL=$H3_AUTH_URL ..."
    res=`gen_jwt`
    # check if the curl request failed
    rc=$?
    if [ $rc -ne 0 ]; then
        echolog "ERROR: " $res
        H3_API_JWT=""
        echo $H3_API_JWT > "$jwt_file"
        return $rc
    fi 
    # check if we didn't get a token back
    # also handles non-JSON responses (e.g. HTML from WAF/proxy) where jq outputs empty string
    token=`cat <<<$res | jq -r .token`
    if [ "$token" = "null" ] || [ -z "$token" ]; then
        echolog "ERROR: " $res
        H3_API_JWT=""
        echo $H3_API_JWT > "$jwt_file"
        return 1
    fi
    # success! set env var, write it to jwt file
    H3_API_JWT=$token
    echo $H3_API_JWT > "$jwt_file"
    echolog H3_API_JWT=$H3_API_JWT
    return 0
}


# 1. check env var 
# 2. read it from the file
# 3. refresh it
# sets H3_API_JWT in the environment
function read_jwt {
    if [ -z "$H3_API_JWT" ]; then
        if [ -f "$jwt_file" ]; then
            H3_API_JWT=`cat "$jwt_file"`
            H3_API_JWT=`echo $H3_API_JWT`    # gets rid of newlines 
        fi 
    fi
    if [ -z "$H3_API_JWT" ]; then
        refresh_jwt_with_fallback
    fi
}


cmd=$1
shift

if [ -z "$cmd" ]; then
    read_jwt

elif [ "$cmd" = "force" ]; then
    refresh_jwt_with_fallback
fi

rc=$?
if [ $rc -eq 0 -o $rc -eq 101 ]; then
    echo $H3_API_JWT 
fi

exit $rc

