#!/bin/bash
#
# usage: h3 auto-injected-credentials
#
# @help
#
# h3-auto-injected-credentials: List all auto-injected credentials in the account.
#
# Usage:
#     h3 auto-injected-credentials
#
# Description:
#     Auto-injected credentials are registered with Horizon3 but stored locally
#     (under ~/.h3 or in Kubernetes) and injected into scheduled pentests by a
#     NodeZero Runner.
#
# See also:
#     h3 create-auto-injected-credential, h3 inject-auto-injected-credential,
#     h3 delete-auto-injected-credential
#

res=`h3-gql auto_injected_credentials`
rc=$?
if [ $rc -eq 0 ]; then cat <<<$res | jq '.data.auto_injected_credentials[]'
else echo "$res"; fi
exit $rc
