#!/bin/bash
#
# Shell script for creating a secret on a NodeZero host.
# 
# usage: h3-cache-secret <agent_secret_uuid>
#

# Include common utils
source h3-env

# Check for required argument
if [ "$#" -ne 1 ]; then
    echoerr "Usage: h3-cache-secret <agent_secret_uuid>"
    exit 1
fi

AGENT_SECRET_UUID=$1

# Build GraphQL query input
json_input="{\"agent_secret_uuid\":\"$AGENT_SECRET_UUID\"}"

# Invoke h3-gql to retrieve the agent secret
res=$(h3-gql agent_secret "$json_input")
rc=$?

if [ $rc -ne 0 ]; then
    echoerr "ERROR: Failed to retrieve agent secret: $res"
    exit $rc
fi

# Extract values from JSON response
ENCRYPTED_SECRET=$(echo "$res" | jq -r '.data.agent_secret.encrypted_secret')
PRIVATE_KEY_PASSPHRASE=$(echo "$res" | jq -r '.data.agent_secret.private_key_passphrase')
SECRET_UUID=$(echo "$res" | jq -r '.data.agent_secret.secret_uuid')
SECRET_TYPE=$(echo "$res" | jq -r '.data.agent_secret.secret_entity_type')

if [ -z "$ENCRYPTED_SECRET" ] || [ -z "$PRIVATE_KEY_PASSPHRASE" ] || [ -z "$SECRET_UUID" ] || [ -z "$SECRET_TYPE" ]; then
    echoerr "ERROR: Failed to parse agent secret response"
    echoerr "$res"
    exit 1
fi

# Decrypt the secret using the agent's private key
# Use $TMPDIR if defined, otherwise fallback to /tmp
TEMP_DIR=${TMPDIR:-/tmp}

# Decode the base64-encoded encrypted secret
echo "$ENCRYPTED_SECRET" | base64 -d > "$TEMP_DIR/encrypted_secret.bin"

# Attempt decryption with OAEP padding and SHA-256 (matching the encryption parameters)
DECRYPTED_SECRET=$(openssl pkeyutl -decrypt -inkey "$H3_CLI_PROFILES_DIR/private_key.pem" -in "$TEMP_DIR/encrypted_secret.bin" -passin "pass:$PRIVATE_KEY_PASSPHRASE" -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 -pkeyopt rsa_mgf1_md:sha256)
rm "$TEMP_DIR/encrypted_secret.bin"

if [ -z "$DECRYPTED_SECRET" ]; then
    echoerr "ERROR: Failed to decrypt agent secret"
    exit 1
fi

# $1: the file to write the secret to
# $2: the secret to write
# Writes the secret to the given file.  On failure, reports the underlying
# error along with the ownership of whatever blocked the write, removes any
# partial file left behind by the truncating redirect, and returns non-zero.
function write_credential {
    target_path=$1
    secret=$2

    # if the target file already exists then it - not its directory - is what
    # the operator needs to look at when the write fails
    if [ -e "$target_path" ]; then
        blocked_path="$target_path"
    else
        blocked_path=$(dirname "$target_path")
    fi

    # capture stderr of the whole group so that we also catch the shell's own
    # message when the redirect itself fails (eg. Permission denied)
    err=$( { echo "$secret" > "$target_path"; } 2>&1 )
    rc=$?
    if [ $rc -ne 0 ]; then
        echoerr "ERROR: Failed to write credential to $target_path: $err"
        echoerr "       $blocked_path is owned by $(file_owner "$blocked_path"), running as $(whoami); fix ownership/permissions and retry"
        # the redirect truncates before the write fails, so don't leave a
        # partial/empty file behind for the credential injection to pick up
        rm -f "$target_path"
        return $rc
    fi
}

# Store the decrypted secret based on entity type
case "$SECRET_TYPE" in
    "ADAccountCredential")
        # Store AD account credential
        ad_agent_dir="$H3_CLI_PROFILES_DIR/ad_agent"
        target_path="$ad_agent_dir/$SECRET_UUID.h3ec"

        if ! mkdir -p "$ad_agent_dir"; then
            echoerr "ERROR: Failed to create directory: $ad_agent_dir"
            exit 1
        fi

        if ! write_credential "$target_path" "$DECRYPTED_SECRET"; then
            exit 1
        fi
        echoerr "INFO: Successfully cached AD account credential with UUID: $SECRET_UUID"
        ;;
    "AutoInjectedCredential")
        # Store Auto-Injected Credential
        target_path="$H3_CLI_PROFILES_DIR/$SECRET_UUID.h3ec"

        if ! write_credential "$target_path" "$DECRYPTED_SECRET"; then
            exit 1
        fi
        echoerr "INFO: Successfully cached auto-injected credential with UUID: $SECRET_UUID"
        ;;
    *)
        echoerr "ERROR: Unknown secret type: $SECRET_TYPE"
        exit 1
        ;;
esac

exit 0
