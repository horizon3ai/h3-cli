#!/bin/bash
#
# Shell script for creating a secret on a NodeZero host.
# 
# usage: h3-cache-secret <agent_secret_uuid>
#

# @help
#
# h3-cache-secret: Cache a decrypted agent secret on a NodeZero host.
#
# Usage:
#     h3 cache-secret <agent_secret_uuid>
#
# Description:
#     Internal helper, normally invoked by NodeZero/Runner. Fetches the
#     agent secret identified by <agent_secret_uuid> via the API, decrypts
#     it with the local agent private key, and writes the decrypted
#     credential to the profiles directory. AD account credentials are
#     stored under ad_agent/<uuid>.h3ec; auto-injected credentials are
#     stored as <uuid>.h3ec.
#
#     A secret tagged "v2:" is enveloped: only its single-use AES key is
#     RSA-encrypted, which allows long credentials such as session cookies and
#     JWTs. An untagged secret uses the legacy format and is unchanged.
#
#     When run by a NodeZero Runner (H3_CLI_RUN_BY_RUNNER_UUID is set) and a
#     per-agent private key exists at
#     $H3_CLI_PROFILES_DIR/private_key/<agent_uuid>.pem, that key is used for
#     decryption; otherwise it falls back to the legacy shared key at
#     $H3_CLI_PROFILES_DIR/private_key.pem.
#
# Options:
#     <agent_secret_uuid>   UUID of the agent secret to fetch and cache.
#
# See also:
#     h3 gql
#

# Include common utils
source h3-env

# Check for required argument
if [ "$#" -ne 1 ]; then
    echoerr "Usage: h3-cache-secret <agent_secret_uuid>"
    exit 1
fi

AGENT_SECRET_UUID=$1

# Build GraphQL query input
json_input="{\"agent_secret_uuid\":\"$AGENT_SECRET_UUID\"}"

# Invoke h3-gql to retrieve the agent secret
res=$(h3-gql agent_secret "$json_input")
rc=$?

if [ $rc -ne 0 ]; then
    echoerr "ERROR: Failed to retrieve agent secret: $res"
    exit $rc
fi

# Extract values from JSON response
ENCRYPTED_SECRET=$(echo "$res" | jq -r '.data.agent_secret.encrypted_secret')
PRIVATE_KEY_PASSPHRASE=$(echo "$res" | jq -r '.data.agent_secret.private_key_passphrase')
SECRET_UUID=$(echo "$res" | jq -r '.data.agent_secret.secret_uuid')
SECRET_TYPE=$(echo "$res" | jq -r '.data.agent_secret.secret_entity_type')

if [ -z "$ENCRYPTED_SECRET" ] || [ -z "$PRIVATE_KEY_PASSPHRASE" ] || [ -z "$SECRET_UUID" ] || [ -z "$SECRET_TYPE" ]; then
    echoerr "ERROR: Failed to parse agent secret response"
    echoerr "$res"
    exit 1
fi

# Decrypt the secret using the agent's private key
# Use $TMPDIR if defined, otherwise fallback to /tmp
TEMP_DIR=${TMPDIR:-/tmp}

# Choose the private key path: the per-agent key private_key/<uuid>.pem when the
# runner set H3_CLI_RUN_BY_RUNNER_UUID and that file exists, otherwise fall back to
# the legacy shared private_key.pem (co-located agents sharing a profile dir each
# have their own per-agent key; not-yet-migrated runners still use the shared key).
if [ -n "$H3_CLI_RUN_BY_RUNNER_UUID" ] && [ -f "$H3_CLI_PROFILES_DIR/private_key/$H3_CLI_RUN_BY_RUNNER_UUID.pem" ]; then
    key_path="$H3_CLI_PROFILES_DIR/private_key/$H3_CLI_RUN_BY_RUNNER_UUID.pem"
else
    key_path="$H3_CLI_PROFILES_DIR/private_key.pem"
    echoerr "INFO: using legacy shared key path $key_path"
fi

# $1: file holding an RSA-encrypted payload
# Decrypts the file with the agent's private key, using OAEP padding and SHA-256
# to match the encryption parameters used by the API.
function rsa_decrypt_file {
    openssl pkeyutl -decrypt -inkey "$key_path" -in "$1" -passin "pass:$PRIVATE_KEY_PASSPHRASE" \
        -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 -pkeyopt rsa_mgf1_md:sha256
}

# Scratch file for the encrypted payload.  The name is per-invocation because a
# busy Runner can have several cache-secret calls in flight at once, and a fixed
# name lets them clobber each other.
enc_file=$(mktemp "$TEMP_DIR/h3-cache-secret.XXXXXX")

# Decrypt the secret.  A "v2:" prefix marks an enveloped secret: the payload is
# encrypted with a single-use AES key, and only that key is RSA-encrypted.  This
# lifts the 190-byte limit RSA imposes, allowing long credentials such as session
# cookies and JWTs.  Without the prefix the payload itself was RSA-encrypted, the
# legacy format.  ':' is not a base64 character, so the two cannot be confused.
# Either way the result is the still-encrypted credential blob; this command
# never sees the credential in the clear.
case "$ENCRYPTED_SECRET" in
    v2:*)
        envelope=$(echo "${ENCRYPTED_SECRET#v2:}" | base64 -d)
        if [ -z "$envelope" ]; then
            echoerr "ERROR: Failed to decode agent secret envelope"
            rm "$enc_file"
            exit 1
        fi

        # the AES key is 96 hex chars, laid out as iv (32) followed by key (64)
        echo "$envelope" | jq -r '.k' | base64 -d > "$enc_file"
        key_material=$(rsa_decrypt_file "$enc_file")
        if [ ${#key_material} -ne 96 ]; then
            echoerr "ERROR: Failed to decrypt agent secret transport key"
            rm "$enc_file"
            exit 1
        fi

        # -A because the API emits base64 as a single line, which openssl does
        # not expect by default
        DECRYPTED_SECRET=$(echo "$envelope" | jq -r '.c' \
            | openssl enc -d -aes-256-cbc -base64 -A -K "${key_material:32}" -iv "${key_material:0:32}")
        ;;
    *)
        echo "$ENCRYPTED_SECRET" | base64 -d > "$enc_file"
        DECRYPTED_SECRET=$(rsa_decrypt_file "$enc_file")
        ;;
esac
rm "$enc_file"

if [ -z "$DECRYPTED_SECRET" ]; then
    echoerr "ERROR: Failed to decrypt agent secret"
    exit 1
fi

# $1: the file to write the secret to
# $2: the secret to write
# Writes the secret to the given file.  On failure, reports the underlying
# error along with the ownership of whatever blocked the write, removes any
# partial file left behind by the truncating redirect, and returns non-zero.
function write_credential {
    target_path=$1
    secret=$2

    # if the target file already exists then it - not its directory - is what
    # the operator needs to look at when the write fails
    if [ -e "$target_path" ]; then
        blocked_path="$target_path"
    else
        blocked_path=$(dirname "$target_path")
    fi

    # capture stderr of the whole group so that we also catch the shell's own
    # message when the redirect itself fails (eg. Permission denied)
    err=$( { echo "$secret" > "$target_path"; } 2>&1 )
    rc=$?
    if [ $rc -ne 0 ]; then
        echoerr "ERROR: Failed to write credential to $target_path: $err"
        echoerr "       $blocked_path is owned by $(file_owner "$blocked_path"), running as $(whoami); fix ownership/permissions and retry"
        # the redirect truncates before the write fails, so don't leave a
        # partial/empty file behind for the credential injection to pick up
        rm -f "$target_path"
        return $rc
    fi
}

# Store the decrypted secret based on entity type
case "$SECRET_TYPE" in
    "ADAccountCredential")
        # Store AD account credential
        ad_agent_dir="$H3_CLI_PROFILES_DIR/ad_agent"
        target_path="$ad_agent_dir/$SECRET_UUID.h3ec"

        if ! mkdir -p "$ad_agent_dir"; then
            echoerr "ERROR: Failed to create directory: $ad_agent_dir"
            exit 1
        fi

        if ! write_credential "$target_path" "$DECRYPTED_SECRET"; then
            exit 1
        fi
        echoerr "INFO: Successfully cached AD account credential with UUID: $SECRET_UUID"
        ;;
    "AutoInjectedCredential")
        # Store Auto-Injected Credential
        target_path="$H3_CLI_PROFILES_DIR/$SECRET_UUID.h3ec"

        if ! write_credential "$target_path" "$DECRYPTED_SECRET"; then
            exit 1
        fi
        echoerr "INFO: Successfully cached auto-injected credential with UUID: $SECRET_UUID"
        ;;
    *)
        echoerr "ERROR: Unknown secret type: $SECRET_TYPE"
        exit 1
        ;;
esac

exit 0
