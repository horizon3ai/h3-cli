#!/bin/bash
#
# 
# usage: h3-create-auto-injected-credential '{"key_type":"cleartext","user":"SMOKE\rob","cleartext":"mypassword"}'
# usage: h3-create-auto-injected-credential '{"key_type":"cleartext","user":"rob","cleartext":"mypassword","ip":"192.168.65.3"}'
# usage: h3-create-auto-injected-credential '{"key_type":"ntlm_hash","user":"rob","hash":"myhash"}'
# usage: h3-create-auto-injected-credential '{"key_type":"ntlm_hash","user":"rob","hash":"myhash","ip":"192.168.65.3"}'
# usage: h3-create-auto-injected-credential '{"key_type":"aws","aws_access_key_id":"AKxxxxLIWA2Y7OSxxxxx","aws_secret_access_key":"DSAfRxxxxxxxxxxxxZaZolXbsBOl0c/2dxxxxxxx","aws_session_token":""}'
# usage: h3-create-auto-injected-credential '{"key_type":"azure-mfa", "mfa_device_flow_id":"12344321-4321-1234-4321-123443211234"}'
# usage: h3-create-auto-injected-credential '{"key_type":"cleartext","user":"SMOKE\rob","cleartext":"mypassword"}' kubernetes mynamespace myrunnername
#

# 0.
# include common utils
source h3-env

# 1.
# parse args

# check for optional sse arg
# if specified, the cred is encrypted on the server-side; 
# otherwise the cred is encrypted client-side using openssl.
sse=$1
if [ "$sse" = "sse" ]; then
    shift
else    
    sse=
fi

# read json input
input=$1

if [ -z "$input" ]; then 
    prompterr "Please provide JSON input on a single line: "
    read -r input
    input=`trim_quotes "$input"`
fi

if [ -z "$input" ]; then 
    echoerr "ERROR: InjectedCredentialInput data is required"
    exit 1
fi

# check for optional kubernetes arg
# if specified, Kubernetes namespace and runner name are required,
# auto injected credential will be created in Kubernetes.
kubernetes=$2
if [ "$kubernetes" = "kubernetes" ]; then
    shift
else    
    kubernetes=
fi

# if kubernetes is specified, namespace and runner name are required
if [ -n "$kubernetes" ]; then
    namespace=$2

    if [ -z "$namespace" ]; then 
        prompterr "Please provide Kubernetes Namespace: "
        read -r namespace
        namespace=`trim_quotes "$namespace"`
    fi

    runner_name=$3
    if [ -z "$runner_name" ]; then 
        prompterr "Please provide Kubernetes Runner Name: "
        read -r runner_name
        runner_name=`trim_quotes "$runner_name"`
    fi
fi

# 2. 
# build variables payload
if [ -z "$sse" ]; then 
    # client-side encryption: only send non-secret fields to GQL
    gql_input=`cat <<<$input | jq -c '{key_type, user, aws_access_key_id, mfa_device_flow_id, ip}'`
else
    # server-side encryption: send everything
    gql_input="$input"
fi
v=`cat <<HERE
{
    "input": $gql_input
}
HERE
`
v1=`escape_splat "$v"`

# 3.
# invoke h3-gql
res=`h3-gql create_auto_injected_credential "$v1"`
rc=$?
if [ $rc -ne 0 ]; then
    echo "$res"
    exit $rc
fi

# 4.
# Encrypt the secret
uuid=`cat <<<$res | jq -r .data.create_auto_injected_credential.auto_injected_credential.uuid`
secret_file="$H3_CLI_PROFILES_DIR/$uuid.h3ec"

if [ -z "$sse" ]; then
    # handle client-side encryption
    echoerr "INFO: Creating auto-injected credential secret using openssl"
    aes_key_hex=`cat <<<$res | jq -r .data.create_auto_injected_credential.aes_key_hex`
    aes_iv_hex=`cat <<<$res | jq -r .data.create_auto_injected_credential.aes_iv_hex`
    secret_input=`cat <<<$input | jq -c '{cleartext, hash, aws_secret_access_key, aws_session_token, mfa_device_flow_id}'`
    encrypted_secret=`echo "$secret_input" | openssl enc -aes-256-cbc -base64 -K "$aes_key_hex" -iv "$aes_iv_hex"`
    rc=$?
else
    # handle server-side encryption
    echoerr "INFO: Writing auto-injected credential secret to $secret_file "
    encrypted_secret=`cat <<<$res | jq -r .data.create_auto_injected_credential.encrypted_secret`
    rc=$?
fi

if [ $rc -ne 0 ]; then
    echoerr "ERROR: Failed to write secret to $secret_file"
    exit $rc
fi

# 5.
# Write the encrypted secret to the file or create an AutoInjectedCredential in Kubernetes
if [ -z "$kubernetes" ]; then
    echoerr "INFO: Writing auto-injected credential secret to $secret_file "
    echo "$encrypted_secret" > "$secret_file"
    rc=$?
    if [ $rc -ne 0 ]; then
        echoerr "ERROR: Failed to write secret to $secret_file"
        exit $rc
    fi
    exit
fi

echoerr "INFO: Creating AutoInjectedCredential in Kubernetes"
encoded_data=`echo "$encrypted_secret" | base64`

# Create and apply the Kubernetes Manifest
aic=$(cat <<EOF
apiVersion: nodezero.horizon3.ai/v1
kind: AutoInjectedCredential
metadata:
  name: ${uuid}
  namespace: ${namespace}
spec:
  runnerName: ${runner_name}
  data: ${encoded_data}
EOF
)

echo "$aic" | kubectl apply -n $namespace -f -

rc=$?

if [ $rc -ne 0 ]; then
    echoerr "ERROR: Failed to create AutoInjectedCredential in Kubernetes"
    exit $rc
fi
