#!/bin/bash
#
# Simple shell script for scheduling an action.
# 
# usage: h3-create-scheduled-action {schedule-name} {cron-expression} {action} [{params}]
#

# @help
#
# h3-create-scheduled-action: Create or update a scheduled action.
#
# Usage:
#     h3 create-scheduled-action <schedule-name> <cron-expression> <action> [params]
#
# Description:
#     Creates (or updates) a scheduled action on the named schedule. Supports
#     hourly-resolution cron. The cron expression uses the format
#     'min hour day month dow' in UTC; see https://crontab.guru/ for help
#     building expressions. Use 'h3 utc' to get the current time in UTC.
#
# Options:
#     <schedule-name>     Name of the schedule (required).
#     <cron-expression>   Cron expression in UTC: 'min hour day month dow' (required).
#     <action>            Action to run on the schedule (required).
#     [params]            Optional JSON params for the action (defaults to {}).
#
# See also:
#     h3 schedule, h3 delete-scheduled-action, h3 trigger-scheduled-action, h3 utc
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
schedule_name=$1
cron_expression=$2
action=$3
params=$4

if [ -z "$schedule_name" ]; then 
    echoerr "ERROR: schedule-name is required"
    exit 1
fi

if [ -z "$cron_expression" ]; then 
    echoerr "ERROR: cron-expression is required"
    exit 1
fi

if [ -z "$action" ]; then 
    echoerr "ERROR: action is required"
    exit 1
fi

if [ -z "$params" ]; then 
    params="{}"
fi


# 2. 
# build variables payload
v=`cat <<HERE
{
    "input": {
        "schedule_name": "$schedule_name",
        "cron_expression": "$cron_expression",
        "action": "$action",
        "params": $params
    }
}
HERE
`

echolog "v=$v"
v1=`escape_splat "$v"`
echolog "v1=$v1"

# 3.
# invoke h3-gql
res=`h3-gql create_scheduled_action "$v1"`
rc=$?
if [ $rc -eq 0 ]; then
    cat <<<$res | jq .data.create_scheduled_action
else
    echo "$res"
    exit $rc
fi


