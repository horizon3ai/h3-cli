#!/bin/bash
#
# 
# usage: h3-delete-auto-injected-credential {uuid}
#
#

# @help
#
# h3-delete-auto-injected-credential: Delete an auto-injected credential.
#
# Usage:
#     h3 delete-auto-injected-credential <uuid>
#
# Description:
#     Deletes the auto-injected credential with the given uuid from H3, then
#     sends a command to the NodeZero Runner to delete the credential from the
#     local machine or Kubernetes, and removes the locally-stored secret.
#
# Options:
#     <uuid>   UUID of the auto-injected credential to delete (required).
#
# See also:
#     h3 create-auto-injected-credential, h3 inject-auto-injected-credential
#


# 0.
# include common utils
source h3-env

# 1.
# parse args
uuid=$1
if [ -z "$uuid" ]; then 
    echoerr "ERROR: uuid is required"
    exit 1
fi

# 2. 
# build variables payload
v=`cat <<HERE
{
    "uuid": "$uuid"
}
HERE
`

# 3.
# invoke h3-gql
res=`h3-gql delete_auto_injected_credential "$v"`
rc=$?
if [ $rc -ne 0 ]; then
    echo "$res"
    exit $rc
fi

# 4.
# delete the secret file
h3-delete-auto-injected-credential-secret "$uuid"




