#!/bin/bash
#
# 
# usage: h3-delete-auto-injected-credential-secret {uuid}
#
#

# @help
#
# h3-delete-auto-injected-credential-secret: Delete the locally-stored secret for an auto-injected credential.
#
# Usage:
#     h3 delete-auto-injected-credential-secret <uuid>
#
# Description:
#     Deletes the locally-stored encrypted secret file for the auto-injected
#     credential with the given uuid. This is normally invoked internally (by
#     h3 delete-auto-injected-credential and the NodeZero Runner) rather than run
#     directly. If the secret file does not exist, it exits successfully.
#
# Options:
#     <uuid>   UUID of the auto-injected credential secret to delete (required).
#
# See also:
#     h3 delete-auto-injected-credential, h3 create-auto-injected-credential
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
uuid=$1
if [ -z "$uuid" ]; then 
    echoerr "ERROR: uuid is required"
    exit 1
fi

# 2.
# read the encrypted secret from the file
secret_file="$H3_CLI_PROFILES_DIR/$uuid.h3ec"
if [ ! -e "$secret_file" ]; then 
    echoerr "WARN: auto-injected credential secret file does not exist or was already deleted: $secret_file"
    exit 0
fi

# 3.
# delete the secret file
echoerr "INFO: Deleting auto-injected credential secret file $secret_file"
rm -f "$secret_file"
exit $?




