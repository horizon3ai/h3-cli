#!/bin/bash
#
# usage: h3 delete-profile <name>
#
# @help
#
# h3-delete-profile: Delete an h3-cli profile.
#
# Usage:
#     h3 delete-profile <name>
#
# Description:
#     Removes the profile's files from ~/.h3.  This does NOT revoke the API key.
#
# Options:
#     <name>   The profile to delete.
#

source h3-utils
profile_name=$1
if [ -z "$H3_CLI_PROFILES_DIR" ]; then
    H3_CLI_PROFILES_DIR="$HOME/.h3"
fi
profile_file="$H3_CLI_PROFILES_DIR/$profile_name.env"
profile_file_bak="$H3_CLI_PROFILES_DIR/$profile_name.env.bak"
jwt_file="$H3_CLI_PROFILES_DIR/$profile_name.jwt"
if [ -e "$profile_file" ]; then
    echoerr "INFO: Deleting h3-cli profile $profile_name under $H3_CLI_PROFILES_DIR ..."
    rm -f "$profile_file" "$jwt_file" "$profile_file_bak"
else
    echoerr "ERROR: Profile $profile_name does not exist under $H3_CLI_PROFILES_DIR ..."
fi
