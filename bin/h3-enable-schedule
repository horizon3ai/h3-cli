#!/bin/bash
#
# Simple shell script for enabling a schedule.
# 
# usage: h3-enable-schedule {schedule-name}
#

# @help
#
# h3-enable-schedule: Enable a schedule.
#
# Usage:
#     h3 enable-schedule <schedule-name>
#
# Description:
#     Enables the named schedule so its scheduled actions run at their cron times.
#
# Options:
#     <schedule-name>   Name of the schedule to enable (required).
#
# See also:
#     h3 schedule, h3 disable-schedule
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
schedule_name=$1

if [ -z "$schedule_name" ]; then 
    echoerr "ERROR: schedule-name is required"
    exit 1
fi

# 2. 
# build variables payload
v=`cat <<HERE
{
    "schedule_name": "$schedule_name"
}
HERE
`

v1=`escape_splat "$v"`

# 3.
# invoke h3-gql
res=`h3-gql enable_schedule "$v1"`
rc=$?
if [ $rc -eq 0 ]; then
    cat <<<$res | jq .data.enable_schedule
else
    echo $res
    exit $rc
fi


