#!/bin/bash
#
# Simple utility for posting a GraphQL query to the H3 API.
# Reads the GraphQL query from a file, writes the response to STDOUT.
#
# See the accompanying README.md for usage info.
#


# @help
#
# h3-gql: Run the GraphQL request in the given <graphql-file>.
#
# Usage:
#     h3 gql <graphql-file> [vars]
#
# Description:
#     Reads a GraphQL query from <graphql-file>, posts it to the API
#     (H3_GQL_URL), and writes the JSON response to STDOUT. The file is
#     located on the search path H3_CLI_GQL_PATH (which includes the
#     queries/ directory), comments are stripped, and any referenced
#     fragments are resolved via h3-gql-resolve-fragments.
#     Authentication is handled automatically, with a retry on expired
#     or unauthorized tokens.
#     [vars] is optional: a JSON document of query variables, or a bare
#     value treated as a single op_id (i.e. {"op_id":"<value>"}).
#
# Options:
#     <graphql-file>   Query file to run, resolved on H3_CLI_GQL_PATH.
#     [vars]           Optional JSON variables, or a bare op_id.
#
# See also:
#     h3 gql-describe, h3 gql-stream, h3 gql-def
#


source h3-env


function refresh_jwt {
    H3_API_JWT=`h3-auth force`
    rc=$?
    if [ $rc -eq 101 ]; then 
        echolog "reloading h3-cli profile ..."
        source_profile
    elif [ $rc -ne 0 ]; then 
        exit $rc
    fi
}


function read_jwt {
    H3_API_JWT=`h3-auth`
    rc=$?
    if [ $rc -eq 101 ]; then 
        echolog "reloading h3-cli profile ..."
        source_profile
    elif [ $rc -ne 0 ]; then 
        exit $rc
    fi
}


# finds the graphql query file on the path (H3_CLI_GQL_PATH)
# @returns the file contents
function read_query {
    ff=`find_query_file $1`
    if [ -z "$ff" ]; then
        return
    fi
    echolog "reading file $ff ..."
    # sed removes comments from the file
    cat -- "$ff" | sed 's/^ *#.*//'
}


# finds the graphql query file on the path (H3_CLI_GQL_PATH)
# @returns the file contents, with all Fragments resolved
function resolve_query {
    h3-gql-resolve-fragments "$1"
}


# @returns gql response (json)
function post_query {
    echolog "posting GQL request to $H3_GQL_URL ..."
    # The query is interpolated into a JSON *string* below, and a raw newline inside a JSON
    # string is invalid -- so a multi-line .graphql file must be flattened to one line.
    #
    # ⚠ This flattening used to happen by accident, as a side effect of the unquoted `main $*`
    # word-splitting everything it touched.  That same expansion also silently corrupted the
    # VARIABLES payload (collapsed whitespace runs, ate tabs, expanded globs), so it was
    # quoted -- which means the query has to be flattened HERE, deliberately and only where
    # it is needed.  Do not "simplify" this away: without it every multi-line query file
    # produces an invalid request body.
    q=`escape_quotes "$1" | tr '\n' ' '`
    v=`unescape_splat "$2"`
    echolog "q=$q"
    echolog "v=$v"
    if [ -z "$v" ]; then v="{}"; fi
    run_curl -s -S \
      -X POST $H3_GQL_URL/ \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $H3_API_JWT" \
      -d @- <<HERE 
{
    "query": "$q",
    "variables": $v
}
HERE
}


# -------------------------------------------------------------------------
# main function
# -------------------------------------------------------------------------


# usage: parse_args "$@"
# if the args are not defined, return nothing.
# if the args contain a json document, return it directly.
# otherwise, treat the arg as a single op_id and return it in json format.
#
# NOTE: "$*", not $*.  Unquoted, this re-joined the words that `main $*` had already split
# the payload into -- which is how a space in a variables JSON "worked" at all, and also
# what silently CORRUPTED it: runs of whitespace collapsed to one space, tabs became
# spaces, and any standalone glob was expanded against the caller's working directory.
function parse_args {
    args="$*"
    if [ -z "$args" ]; then
        return 
    fi
    # if raw json provided, return it
    if [[ $args == *"{"* ]]; then
        echo "$args"
        return
    fi
    if [[ $args == *" "* ]]; then
        echoerr "ERROR: invalid arguments: $args"
        exit 1
    fi
    # otherwise assume it's an op_id.
    echo "{\"op_id\":\"$args\"}"
}


# read / refresh the jwt.
# read the graphql query from the file/stdin.
# post the query
# catch auth failures, refresh jwt, retry
# print out the response
function main {
    # read the query
    read_jwt
    # -rx- q=`read_query $*`
    q=`resolve_query "$1"`
    if [ -z "$q" ]; then
        echoerr "ERROR: could not resolve query $1"
        exit 1
    fi

    # read the vars
    shift
    # NOTE: "$@", not $*.  The old comment here read "use $* otherwise doesn't handle spaces
    # in $2" -- but that only appeared to work because `main $*` had ALREADY split the
    # payload on whitespace and parse_args re-joined it.  A round trip through
    # split-then-rejoin is not identity: it collapsed runs of whitespace, turned tabs into
    # spaces, and glob-expanded a standalone `*` against the caller's working directory.
    v=`parse_args "$@"`

    # run the query 
    r=`post_query "$q" "$v"`
    rc=$?
    # echolog "post_query response: $?: $r"
    if [ "$r" = '{"message":"The incoming token has expired"}' -o "$r" = '{"Message":"Access Denied"}' -o "$r" = '{"message":"Unauthorized"}' ]
    then 
        refresh_jwt
        r=`post_query "$q" "$v"`
        rc=$?
    fi

    echo "$r"

    if [ "$r" = "Request body is not a valid JSON" ]; then
        exit 1
    fi

    # check errors
    # echolog "checking for errors"
    error_message=`cat <<<$r | jq -r .errors[]?.message`
    if [ -n "$error_message" ]; then 
        exit 1
    fi

    exit $rc
}

# "$@", not $*: an unquoted expansion here word-split the caller's variables JSON and
# glob-expanded it against the current directory before main ever saw it.
main "$@"




