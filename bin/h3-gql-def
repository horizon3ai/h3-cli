#!/bin/bash
#
# Fetch the GraphQL API schema definition for the given scheme element.
#
# usage: h3-gql-def {id} 
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
id=$1
if [ -z "$id" ]; then
    echoerr "id is required. Try 'Query' to start."
    exit 1
fi

# 2.
# call GQL
json_params=`cat <<HERE
{"id":"$id"}
HERE
`
res=`h3-gql gql_def "$json_params"`
rc=$?
if [ $rc -eq 0 ]; then 
    cat <<<$res | jq '.data.graphql_def'
else 
    echo "$res"; 
    exit $rc
fi

