#!/bin/bash
#
# Given a graphql query file and a search path (H3_CLI_GQL_PATH) containing *Fragment.graphql files,
# resolve all unersolved Fragments in the graphql query by importing them from their respective
# *Fragment.graphql file.
#
# Fragments can be defined in their own file, named {fragment-name}.graphql.
# Those Fragments can then be referenced from a graphql query file in the usual way
# using the spread operator, ie: "...{fragment-name}".
#
# Fragments can also be defined directly in the graphql query file. This effectively overrides
# the *Fragment.graphql file, if one is defined.  This script will only resolve Fragments that are
# not already defined in the query file.
#
# CONCURRENCY: two h3-gql requests can fire at the same time, so this script must be safe to
# run concurrently.  It keeps the query in shell variables and compares fragment sets via
# process substitution.
#

# @help
#
# h3-gql-resolve-fragments: Inline GraphQL fragment references in a query file.
#
# Usage:
#     h3 gql-resolve-fragments <graphql-file>
#
# Description:
#     Internal helper, normally invoked by h3 gql. Reads <graphql-file>
#     (located on H3_CLI_GQL_PATH), strips comments, and recursively
#     resolves any unresolved fragment references (spread as ...XxxFragment)
#     by importing them from their matching <fragment-name>.graphql files
#     on the path. Fragments already defined in the query file are left
#     as-is. Prints the fully-resolved query to STDOUT.
#
# Options:
#     <graphql-file>   Query file whose fragments should be resolved.
#
# See also:
#     h3 gql
#

source h3-env


# find all spread fragments
# subtract already-defined fragments
# :param stdin: the (comment-stripped) graphql query text
# :returns: the remaining set of fragments.  These are the unresolved fragments that need to be imported.
function find_unresolved_fragments {
    query=`cat`
    comm -23 \
        <(grep -e '[.]\{3\}\S*Fragment' <<<"$query" | sed 's/.*[.][.][.]\(.*Fragment\).*/\1/' | sort | uniq) \
        <(grep -e 'fragment \S*Fragment' <<<"$query" | sed 's/.*fragment \(.*Fragment\) on.*/\1/g' | sort | uniq)
}


# 0.
# read graphql query file
ff=`find_query_file $1`
if [ -z "$ff" ]; then
    exit 1
fi

# 1.
# read the query, remove comments
full_query=`cat -- "$ff" | sed 's/^ *#.*//'`

# 2.
# recursively resolve fragments
fragments=`find_unresolved_fragments <<<"$full_query"`
while [ -n "$fragments" ]; do
    # 3.
    for x in $fragments; do
        fragment_file=`find_query_file $x.graphql`
        if [ -z "$fragment_file" ]; then
            echoerr "ERROR: could not find fragment $x"
            exit 1
        fi
        # append the fragment, comment-stripped, separated by blank lines so its
        # `fragment X on Y {` opener never merges into the preceding line.
        full_query="$full_query


`cat -- "$fragment_file" | sed 's/^ *#.*//'`"
    done
    fragments=`find_unresolved_fragments <<<"$full_query"`
done

# 4.
# print the final query.  printf, not echo: echo could eat a leading -n/-e or mangle
# backslashes under xpg_echo, whereas the query text must pass through byte-for-byte.
printf '%s\n' "$full_query"
