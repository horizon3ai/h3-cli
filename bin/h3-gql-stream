#!/bin/bash
#
# Streams paginated GQL output.
#
# usage:
# h3-gql-stream weaknesses.graphql .data.weaknesses_page.weaknesses '{"op_id":"66063d2b-1766-406c-8dd0-e1b9da1099f7"}'
#
# for a CSV:
# h3-gql-stream weaknesses.graphql .data.weaknesses_page.weaknesses '{"op_id":"66063d2b-1766-406c-8dd0-e1b9da1099f7"}' | jq -rsf $H3_CLI_HOME/filters/to_csv.jq
#
# NOTE: the graphql query file must define $page_input: PageInput  as a parameter.
# 


# @help
#
# h3-gql-stream: Stream output from a paginated query in <graphql-file>.
#
# Usage:
#     h3 gql-stream <graphql-file> <array-field> [vars]
#
# Description:
#     Repeatedly runs <graphql-file>, incrementing page_num, and streams
#     the elements of <array-field> from each response to STDOUT.
#     Streaming continues until <array-field> in the response is empty
#     (or 99 pages are reached); each page fetches 20 elements. The query
#     file MUST define and use the
#     parameter $page_input: PageInput. <array-field> is a jq path to the
#     result array; a leading ".data" and "." are added if omitted.
#
#     For a CSV, pipe to:
#         jq -rsf $H3_CLI_HOME/filters/to_csv.jq
#
# Options:
#     <graphql-file>   Paginated query file, resolved on H3_CLI_GQL_PATH.
#     <array-field>    jq path to the array result to stream.
#     [vars]           Optional JSON variables merged with page_input.
#
# See also:
#     h3 gql, h3 gql-def, h3 gql-describe
#


source h3-env


function build_page_input_args {
    page_num=$1
    cat <<HERE
{
    "page_input":{
        "page_num": $page_num,
        "page_size": 20
    }
}
HERE
}

# 1.
# parse args

# the graphql query file.
# the file must take a page_input arg.
query_file="$1"

# the path to the array result within the query.
# the script stops paginating once the array result is empty.
p="$2"
if [[ "$p" != "."* ]]; then 
    p=".$p"
fi
if [[ "$p" != ".data"* ]]; then 
    p=".data$p"
fi

# additional args for the graphql query.
args="$3"


# 2.
# read page by page until we get back an empty result 
page_num=1
while [ $page_num -lt 100 ]; do 

    # add page_input arg
    page_input_args=`build_page_input_args $page_num`
    json_params=`combine_json "$args" "$page_input_args"`

    # run the query
    res=`h3-gql "$query_file" "$json_params"`
    rc=$?
    if [ $rc -ne 0 ]; then
        echoerr "API request failed: rc=$rc, res=$res"
        exit $rc
    fi

    # check if result is empty
    r=`cat <<<"$res" | jq -r "$p" | jq -e '. == []'`
    rc=$?
    if [ $rc -eq 0 ]; then
        echolog "array is empty; rc=$rc"
        break
    fi

    # stream the results, loop.
    cat <<<"$res" | jq -r "${p}[]"
    page_num=$((page_num + 1))

done
