#!/bin/bash
#
# Called by the agent/runner when it receives a command to run.
#
# Runs a given h3-cli command.
# Logs the output to a file.
# Reports back the exit status and log.
#
# usage: $ h3 run-command {cmd-uuid} {cmd}
#
#

# 0.
# include common utils
source h3-env


# 1. 
# parse input
command_uuid=$1
if [ -z "$command_uuid" ]; then
    echoerr "command-uuid is required"
    exit 1
fi

command=$2
if [ -z "$command" ]; then
    echoerr "command is required"
    exit 1
fi

log_file="$H3_CLI_LOGGING_DIR/$command_uuid.log"

# 2. 
# run the command
# log output to a file AND to stdout (using tee).
# We log to stdout so the output also shows in the agent/runner log.
echoerr "RUN: h3 $command; LOG FILE: $log_file" 
eval "h3 $command" 2>&1 | tee "$log_file" 
rc=${PIPESTATUS[0]}

# 3.
# report back 
json_params=`cat <<HERE
{"input":{"agent_command_uuid":"$command_uuid","exit_status":"$rc"}}
HERE
`
echoerr "COMPLETE: h3 $command; RC: $rc; posting results ..." 
res=`h3-gql agent_command_complete "$json_params"`
rc=$?
if [ $rc -eq 0 ]; then 
    # upload the log
    log_upload_url=`cat <<<$res | jq -r '.data.agent_command_complete.log_upload_url'`
    gateway_redirect_json=`cat <<<$res | jq -c '.data.agent_command_complete.gateway_redirect // {}'`
    parse_gateway_redirect "$gateway_redirect_json"
    upload_url="$log_upload_url"
    if [ -n "$gateway_url" ]; then
        upload_url="$gateway_url"
    fi
    curl_response=$(run_curl -X PUT -H "Content-Type: text/plain" "${extra_header[@]}" -T "$log_file" "$upload_url")
    if echo "$curl_response" | grep -q '<Error>' && [ -n "$gateway_url" ]; then
        echoerr "WARN: gateway upload failed, retrying with original url ..."
        run_curl -X PUT -H "Content-Type: text/plain" -T "$log_file" "$log_upload_url"
    fi
else 
    echo "$res"
fi

echoerr "REMOVING LOG FILE: $log_file"
rm "$log_file"

exit $rc


# NOTE: the `# @help` block is placed at the END of this file on purpose.
# h3-run-command runs `h3 upgrade`, which overwrites this very file in place while
# it is still executing; bash resumes reading by byte offset, so the body above must
# keep its original byte layout for the upgrade to complete and the runner to respawn
# (see tests/test_h3_upgrade_runner.py).  The centralized --help dispatch in bin/h3
# extracts this block regardless of where it sits, so keeping it below `exit`
# (never reached in normal execution) is safe.
# @help
#
# h3-run-command: Run a queued h3-cli command and report its result.
#
# Usage:
#     h3 run-command <cmd-uuid> <cmd>
#
# Description:
#     Runs the h3-cli command <cmd>, tees its output to a per-command log file,
#     and reports the exit status back via the agent_command_complete mutation,
#     then uploads the log to the returned URL. Normally invoked by a NodeZero
#     Runner's poll loop when it picks up a queued agent command, not by hand.
#
# Options:
#     <cmd-uuid>   uuid of the agent command being run.
#     <cmd>        the h3-cli command to execute (e.g. "run-container <uuid>").
#