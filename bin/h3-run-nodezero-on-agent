#!/bin/bash
#
# Queues a comand to the given agent/runner to run NodeZero for the given op.
#
# usage: h3-run-nodezero-on-agent {op-id} {agent-name}
#

# @help
#
# h3-run-nodezero-on-agent: Run NodeZero for a pentest on a Runner.
#
# Usage:
#     h3 run-nodezero-on-runner <op_id> <name>
#     h3 run-nodezero-on-agent <op_id> <name>
#
# Description:
#     Queues a command to the given Runner (agent) to run NodeZero for the given
#     op. Both op_id and the Runner/agent name are required.
#
# Options:
#     op_id   The pentest to run.
#     name    The name of the Runner (agent) to run NodeZero on.
#
# See also:
#     h3 run-nodezero, h3 run-pentest-and-nodezero
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
op_id=$1
if [ -z "$op_id" ]; then
    echoerr "op_id is required"
    exit 1
fi

agent_name=$2
if [ -z "$agent_name" ]; then
    echoerr "name is required"
    exit 1
fi

# 2.
# call GQL
json_params=`cat <<HERE
{"op_id":"$op_id", "agent_name":"$agent_name"}
HERE
`
res=`h3-gql run_nodezero_on_agent "$json_params"`
rc=$?
if [ $rc -eq 0 ]; then 
    cat <<<$res | jq '.data.run_nodezero_on_agent.agent_command'
else 
    echo "$res"; 
    exit $rc
fi

