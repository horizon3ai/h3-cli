#!/bin/bash
#
# usage: h3-stop-nodezero
#
# Stops all NodeZero containers running.
#

source h3-env

detect_container_runtime

# 1. Query for any NodeZero containers.
nodezero_containers=$($CONTAINER_RUNTIME_CMD ps --format '{{.Names}}' | grep n0-)

# 2. For each NodeZero container, run container stop.
for container in $nodezero_containers
do
  res=$($CONTAINER_RUNTIME_CMD stop $container)
  echo "Stopped NodeZero container $res."
done
