#!/bin/bash
#
# usage: h3-stop-nodezero
#
# Stops all NodeZero containers running.
#

source h3-env

# 1. Query for any NodeZero containers.
docker_containers=$(docker ps --format '{{.Names}}' | grep n0-)

# 2. For each NodeZero container, run docker stop.
for docker_container in $docker_containers
do
  res=$(docker stop $docker_container)
  echo "Stopped NodeZero container $res."
done
