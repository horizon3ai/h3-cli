#!/bin/bash
#
# Tail the log for a given agent.
#
# usage: h3-tail-agent {agent-name}
#

# @help
#
# h3-tail-agent: Tail the log for the Runner on the local machine with the given name.
#
# Usage:
#     h3 tail-runner <name>
#     h3 tail-agent <name>
#
# Description:
#     Looks up the NodeZero Runner (a.k.a. agent) with the given <name>,
#     reads the log file registered with it, and tails that log file on the
#     local machine (tail -n 100 -f). Errors if no log file is registered
#     with the Runner.
#
# Options:
#     <name>   Name of the Runner whose log to tail (required).
#
# See also:
#     h3 agent, h3 start-runner-service
#

# 0.
# include common utils
source h3-env


res=`h3-agent "$@"`
rc=$?
if [ $rc -ne 0 ]; then 
    echo "$res"; 
    exit $rc
fi

log_file=`cat <<<$res | jq -r '.log_file'`
if [ -z "$log_file" -o "$log_file" = "null" ]; then
    echoerr "[ERROR] No log file is registered with the Runner. The Runner may need to be upgraded to the latest h3-cli and restarted."
    exit 1
fi

tail -n 100 -f "$log_file"

