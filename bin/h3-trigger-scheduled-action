#!/bin/bash
#
# Simple shell script for triggering a scheduled action (for testing purposes).
# 
# usage: h3-trigger-scheduled-action {schedule-name} {action}
#

# @help
#
# h3-trigger-scheduled-action: Trigger a scheduled action now.
#
# Usage:
#     h3 trigger-scheduled-action <schedule-name> <action>
#
# Description:
#     Immediately triggers the given action on the named schedule, without
#     waiting for its cron time. Intended for testing scheduled actions.
#
# Options:
#     <schedule-name>   Name of the schedule (required).
#     <action>          Action to trigger (required).
#
# See also:
#     h3 schedule, h3 create-scheduled-action, h3 delete-scheduled-action
#

# 0.
# include common utils
source h3-env

# 1.
# parse args
schedule_name=$1
action=$2

if [ -z "$schedule_name" ]; then 
    echoerr "ERROR: schedule-name is required"
    exit 1
fi

if [ -z "$action" ]; then 
    echoerr "ERROR: action is required"
    exit 1
fi


# 2. 
# build variables payload
v=`cat <<HERE
{
    "input": {
        "schedule_name": "$schedule_name",
        "action": "$action"
    }
}
HERE
`

v1=`escape_splat "$v"`

# 3.
# invoke h3-gql
res=`h3-gql trigger_scheduled_action "$v1"`
rc=$?
if [ $rc -eq 0 ]; then
    cat <<<$res | jq .
else
    echo $res
    exit $rc
fi


