#!/bin/bash 
#
# self-upgrade.
#
# usage: h3 upgrade [ng]
#       
#   ng: use the Nodezero Gateway URL for download 
#

source h3-env

h3_download_url=$1

# Update the download URL in the global profile, if provided
if [ "$h3_download_url" == "ng" ]; then
    H3_CLI_DOWNLOAD_URL="https://downloads.horizon3ai.com/utilities/cli/h3-cli.zip"
    ensure_profile "$H3_CLI_PROFILES_DIR/__global__.env"
    upsert_profile_var "$H3_CLI_PROFILES_DIR/__global__.env" "H3_CLI_DOWNLOAD_URL" "$H3_CLI_DOWNLOAD_URL"
fi

# export so it's available to easy_install.sh
export H3_CLI_HOME=$H3_CLI_HOME

# IF H3_CLI_DOWNLOAD_URL is set, use it to fetch easy_install.sh
# this ensure that we use the right easy_install.sh for the version being installed.
if [ -n "$H3_CLI_DOWNLOAD_URL" ]; then
    H3_CLI_EASY_INSTALL_URL=`dirname "$H3_CLI_DOWNLOAD_URL"`/easy_install.sh
    curl "$H3_CLI_EASY_INSTALL_URL" | bash
    rc=$?
    if [ $rc -ne 0 ]; then
        echoerr "ERROR: easy_install.sh failed with exitcode=$rc. Retrying ..."
        bash "$H3_CLI_HOME/easy_install.sh"
        rc=$?
    fi
else
    bash "$H3_CLI_HOME/easy_install.sh"
    rc=$?
fi

exit $rc