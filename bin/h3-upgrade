#!/bin/bash 
#
# self-upgrade.
#
# usage: h3 upgrade [ng]
#       
#   ng: use the Nodezero Gateway URL for download 
#

source h3-env

h3_download_url=$1

# Update the download URL in the global profile, if provided
if [ "$h3_download_url" == "ng" ]; then
    H3_CLI_DOWNLOAD_URL="https://downloads.horizon3ai.com/utilities/cli"
    ensure_profile "$H3_CLI_PROFILES_DIR/__global__.env"
    upsert_profile_var "$H3_CLI_PROFILES_DIR/__global__.env" "H3_CLI_DOWNLOAD_URL" "$H3_CLI_DOWNLOAD_URL"
fi

# export so it's available to easy_install.sh
export H3_CLI_HOME=$H3_CLI_HOME

# Normalize H3_CLI_DOWNLOAD_URL to a base directory URL.
# Existing installs may have the full zip URL (e.g. .../h3-cli.zip); strip the filename.
case "$H3_CLI_DOWNLOAD_URL" in
    *.zip|*.tar.gz) H3_CLI_DOWNLOAD_URL=$(dirname "$H3_CLI_DOWNLOAD_URL") ;;
esac

# IF H3_CLI_DOWNLOAD_URL is set, use it to fetch easy_install.sh
# this ensure that we use the right easy_install.sh for the version being installed.
if [ -n "$H3_CLI_DOWNLOAD_URL" ]; then
    H3_CLI_EASY_INSTALL_URL="${H3_CLI_DOWNLOAD_URL}/easy_install.sh"
    curl "$H3_CLI_EASY_INSTALL_URL" | bash
    rc=$?
    if [ $rc -ne 0 ]; then
        echoerr "ERROR: easy_install.sh failed with exitcode=$rc. Retrying ..."
        bash "$H3_CLI_HOME/easy_install.sh"
        rc=$?
    fi
else
    bash "$H3_CLI_HOME/easy_install.sh"
    rc=$?
fi

exit $rc


# NOTE: the `# @help` block is placed at the END of this file on purpose.
# h3-upgrade runs easy_install.sh, which overwrites this very file in place while it
# is still executing; bash resumes reading by byte offset, so the body above must keep
# its original byte layout or the resume lands mid-token and re-triggers the install
# (see tests/test_h3_upgrade_runner.py).  The centralized --help dispatch in bin/h3
# extracts this block regardless of where it sits, so keeping it below `exit`
# (never reached in normal execution) is safe.
# @help
#
# h3-upgrade: Upgrade h3-cli to the latest version.
#
# Usage:
#     h3 upgrade [ng]
#
# Description:
#     Downloads and runs easy_install.sh to self-upgrade the h3-cli
#     installation in place. The download source is H3_CLI_DOWNLOAD_URL.
#     Passing 'ng' switches the download URL to the NodeZero Gateway (NG)
#     endpoint and persists it to the global profile before upgrading.
#
# Options:
#     ng   Upgrade using the NodeZero Gateway download URL.
#