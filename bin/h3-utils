#!/bin/bash


# writes message to stderr
# usage: echoerr "the message"
function echoerr { 
    echo "[`date`] $*" 1>&2;
}

function prompterr { 
    echo "$@" 1>&2;   
}

# writes message to stderr 
# usage: echolog "the message"
function echolog { 
    if [ "$H3_CLI_VERBOSE" = "1" ]; then
        echo "[`date`] $*" 1>&2;
    fi
}

# NOTE on the three helpers below: the here-string argument is QUOTED ("$1", not $1).
# Unquoted, a here-string still undergoes word splitting, so every one of these silently
# collapsed runs of whitespace and turned tabs into spaces in whatever it was handed --
# including a GraphQL variables payload on its way to the API.
function escape_splat {
    cat <<<"$1" | sed 's/\*/\\*/g'
}

function escape_quotes {
    cat <<<"$1" | sed 's/"/\\"/g'
}

function unescape_splat {
    cat <<<"$1" | sed 's/\\\*/*/g'
}

function ensure_H3_CLI_PROFILE {
    if [ -z "$H3_CLI_PROFILE" ]; then
        H3_CLI_PROFILE="default"
    fi
}

# note: dup'ed in easy_install.sh
function ensure_H3_CLI_PROFILES_DIR {
    if [ -z "$H3_CLI_PROFILES_DIR" ]; then
        # check $HOME is defined and exists
        if [ -z "$HOME" -o ! -e "$HOME" ]; then 
            echoerr "ERROR: This script requires the HOME environent variable to be set to the user's home directory."
            exit 1
        fi
        H3_CLI_PROFILES_DIR="$HOME/.h3"
    fi
}

function assert_H3_CLI_PROFILES_DIR {
    ensure_H3_CLI_PROFILES_DIR
    if [ ! -e "$H3_CLI_PROFILES_DIR" ]; then
        sudo_msg=""
        if is_root_user; then 
            sudo_msg=" If you are running via sudo, try using sudo -E to preserve your environment settings."
        fi
        echoerr "ERROR: h3 profile directory H3_CLI_PROFILES_DIR=$H3_CLI_PROFILES_DIR does not exist. Please create and define a profile.$sudo_msg See README for more info."
        exit 1
    fi
}

function ensure_H3_CLI_LOGGING_DIR {
    # logging for nodezero runners
    # order of precedence: LOGDIR, TMPDIR, /tmp, .
    if [ -z "$H3_CLI_LOGGING_DIR" -o ! -e "$H3_CLI_LOGGING_DIR" ]; then
        H3_CLI_LOGGING_DIR="$LOGDIR"
    fi
    if [ -z "$H3_CLI_LOGGING_DIR" -o ! -e "$H3_CLI_LOGGING_DIR" ]; then
        H3_CLI_LOGGING_DIR="$TMPDIR"
    fi
    if [ -z "$H3_CLI_LOGGING_DIR" -o ! -e "$H3_CLI_LOGGING_DIR" ]; then
        H3_CLI_LOGGING_DIR="/tmp"
    fi
    if [ -z "$H3_CLI_LOGGING_DIR" -o ! -e "$H3_CLI_LOGGING_DIR" ]; then
        H3_CLI_LOGGING_DIR="."
    fi
}

function ensure_H3_CLI_RUN_CONTAINER_OUTPUT_DIR {
    # where h3-run-container writes per-run container output, and where
    # h3-post-container-results looks for it.
    # order of precedence: H3_CLI_RUN_CONTAINER_OUTPUT_DIR, TMPDIR, /tmp
    #
    # NOTE: unlike H3_CLI_LOGGING_DIR, an operator-provided value is used AS-IS even if it
    # does not exist yet -- the callers create it.  Silently falling back to /tmp because
    # the configured directory has not been created yet would write results where
    # h3-post-container-results does not look (or vice versa).
    if [ -z "$H3_CLI_RUN_CONTAINER_OUTPUT_DIR" ]; then
        local parent="$TMPDIR"
        if [ -z "$parent" ] || [ ! -e "$parent" ]; then
            parent="/tmp"
        fi
        # strip any trailing slash ($TMPDIR usually has one) so the path stays tidy
        H3_CLI_RUN_CONTAINER_OUTPUT_DIR="${parent%/}/h3-cli/run-container-output"
    fi
}

function ensure_H3_CLI_HOME {
    if [ -z "$H3_CLI_HOME" ]; then
        d=`dirname $(which h3)`
        if [ "$d" = "." ]; then 
            H3_CLI_HOME=".."
        else 
            H3_CLI_HOME=`dirname "$d"`
        fi
        if [ -z "$H3_CLI_HOME" ]; then
            echoerr "H3_CLI_HOME environment variable required.  Must be set to the full path of the h3-cli directory."
            exit 1
        fi
        H3_CLI_HOME=`abs_path "$H3_CLI_HOME"`
    fi
}

function assert_H3_CLI_HOME {
    ensure_H3_CLI_HOME
    if [ ! -e "$H3_CLI_HOME" ]; then 
        echoerr "H3_CLI_HOME environment variable does not refer to an existing directory ($H3_CLI_HOME).  Must be set to the full path of the h3-cli directory."
        exit 1
    fi
}

function source_profile {
    # check profile
    ensure_H3_CLI_PROFILES_DIR
    ensure_H3_CLI_PROFILE
    profile="$H3_CLI_PROFILES_DIR/$H3_CLI_PROFILE.env"
    if [ -e "$profile" ]; then
        echolog "reading profile $profile ..."
        source $profile
    fi
}

function ensure_H3_API_KEY {
    # check env
    if [ -z "$H3_API_KEY" ]; then
        # check profile
        source_profile
    fi
}
    
function assert_H3_API_KEY {
    ensure_H3_API_KEY
    if [ -z "$H3_API_KEY" ]; then
        echoerr "H3_API_KEY environment variable required.  It must be exported to the shell or defined in $profile"
        exit 1
    fi
    API_KEY_UNSPECIFIED="your-api-key-here"     # NOTE: keep in sync with install.sh.
    if [ "$H3_API_KEY" = "$API_KEY_UNSPECIFIED" ]; then
        echoerr "Please set your API key in $profile"
        exit 1
    fi
}

function ensure_H3_AUTH_URL {
    if [ -z "$H3_AUTH_URL" ]; then
        H3_AUTH_URL=https://api.horizon3ai.com/v1/auth
    fi
}

function ensure_H3_GQL_URL {
    if [ -z "$H3_GQL_URL" ]; then
        H3_GQL_URL=https://api.horizon3ai.com/v1/graphql
    fi
}

function ensure_H3_CLI_GQL_PATH {
    # allow users to define H3_CLI_GQL_PATH
    # always PRE-pend H3_CLI_HOME/queries
    ensure_H3_CLI_HOME
    prepend_gql_path="$H3_CLI_HOME/queries"
    if [ -e "$H3_CLI_HOME/queries-admin" ]; then
        prepend_gql_path="$H3_CLI_HOME/queries-admin:$prepend_gql_path"
    fi

    if [ -z "$H3_CLI_GQL_PATH" ]; then
        H3_CLI_GQL_PATH=$prepend_gql_path
    elif [[ "$H3_CLI_GQL_PATH" != *"$prepend_gql_path"* ]]; then
        H3_CLI_GQL_PATH="$prepend_gql_path:$H3_CLI_GQL_PATH"
    fi
}

# :returns: 0 if systemd is running; non-zero otherwise
function is_systemd_running {
    if ! command -v systemctl &> /dev/null; then
        return 1
    fi
    if ! command -v systemd-notify &> /dev/null; then
        return 1
    fi
    # below returns non-zero if "degraded" (some services did not start)
    # systemctl is-system-running --quiet
    systemd-notify --booted
    return $?
}

# :returns: 0 if the process was launched by systemd; non-zero otherwise
function was_launched_by_systemd {
    if [ "$(ps -o comm= $PPID)" = "systemd" ]; then
        return 0
    else
        return 1
    fi
}

function runner_services {
    if is_systemd_running; then 
        echo systemctl status 'nodezero-runner*'
        systemctl status 'nodezero-runner*'
    else 
        echoerr "ERROR: systemd does not appear to be running"
    fi
}

function is_root_user {
    if [ "$(id -u)" -eq 0 ]; then 
        return 0
    else
        return 1
    fi
}

function ps_agent {
    ps -ef | grep h3-start-agent | grep -v grep
}

function pkill_agent {
    agent_name=$1
    ps_agent
    if [ -z "$agent_name" ]; then 
        echoerr "Killing all NodeZero Runner processes ..."
        pkill -f "h3-start-agent"
    else
        echoerr "Killing NodeZero Runner process $agent_name ..."
        pkill -f "h3-start-agent $agent_name "
    fi
    sleep 2
    ps_agent
}

# Detect available container runtime (prefer docker, fallback to podman)
# Sets CONTAINER_RUNTIME and CONTAINER_RUNTIME_CMD (with sudo if needed)
function detect_container_runtime {
    if command -v docker &> /dev/null; then
        CONTAINER_RUNTIME=docker
    elif command -v podman &> /dev/null; then
        CONTAINER_RUNTIME=podman
        echoerr "INFO: Docker not found. Using Podman as container runtime."
    else
        echoerr "ERROR: Neither Docker nor Podman found. Please install Docker or Podman."
        exit 1
    fi

    # Podman always requires sudo for rootful execution.
    # For Docker, check if we can talk to the daemon without sudo first.
    if [[ "$CONTAINER_RUNTIME" == "podman" ]]; then
        CONTAINER_RUNTIME_CMD="sudo $CONTAINER_RUNTIME"
    elif timeout 5 $CONTAINER_RUNTIME info &>/dev/null; then
        CONTAINER_RUNTIME_CMD="$CONTAINER_RUNTIME"
    else
        CONTAINER_RUNTIME_CMD="sudo $CONTAINER_RUNTIME"
    fi
}

# converts relative path to absolute path
# https://stackoverflow.com/a/31605674
function abs_path {
    f=$1
    if [ ! -e "$f" ]; then 
        # echoerr "file $f does not exist"
        echo $f
    else
        echo "$(cd "$(dirname "$f")"; pwd)/$(basename "$f")"
    fi
} 

# $1: a file or directory path
# returns the name of the user that owns the given path, or the empty string
# if it cannot be determined.  Handles both GNU (-c '%U') and BSD/macOS
# (-f '%Su') flavors of stat.
function file_owner {
    f=$1
    owner=$(stat -c '%U' "$f" 2>/dev/null)
    if [ -z "$owner" ]; then
        # macOS stat uses different flags
        owner=$(stat -f '%Su' "$f" 2>/dev/null)
    fi
    echo "$owner"
}

# trims single quotes from the input
function trim_quotes {
    s=$1
    sed -e "s/^'//" -e "s/'$//" <<<"$s"
}

# returns the input string with any chars that aren't file-path-safe replaced with "-"
function slugify {
    s=$1
    sed -E 's/[^a-zA-Z0-9-]+/-/g' <<<"$s"
}

# $1: the graphql query file basename
# finds the graphql query file on the path (H3_CLI_GQL_PATH)
# @returns the file name
function find_query_file {
    f=$1
    if [ -z "$f" ]; then
        echoerr "ERROR: graphql query file required"
        exit 1
    fi
    echolog "searching for GQL file $f in H3_CLI_GQL_PATH=$H3_CLI_GQL_PATH ..."
    if [[ $f == *"/"* ]]; then
        if [ -e "$f" ]; then
            echo $f 
            return
        fi
        echoerr "ERROR: file not found: $f"
        exit 1
    fi
    prev_IFS=$IFS 
    IFS=:
    dirs=($H3_CLI_GQL_PATH)
    IFS=$prev_IFS
    # the find command searches all subdirs as well, which isn't what we want 
    # (and can take a while)
    # find "${dirs[@]}" -depth 0 -name "$f" -o -name "$f.graphql"
    for d in "${dirs[@]}"; do
        if [ -e "$d/$f" ]; then
            echo "$d/$f"
            return
        fi
        if [ -e "$d/$f.graphql" ]; then
            echo "$d/$f.graphql"
            return
        fi
    done
    echoerr "ERROR: file not found; searching for $f in H3_CLI_GQL_PATH=$H3_CLI_GQL_PATH"
    exit 1
}

# NOTE: wrap parameters in "" to avoid inadvertant shell expansion of asterisks '*'
function combine_json {
    echo "$*" | jq -s add
}


function build_op_id_args {
    op_id=$1
    if [ -z "$op_id" ]; then 
        echoerr "ERROR: op_id is required"
        exit 1
    fi
    cat <<HERE
{"op_id":"$op_id"}
HERE
}


function run_curl {
    user_agent=${H3_CLI_USER_AGENT:-"h3-cli/`h3-version`"}
    if [ -z "$H3_CLI_PROXY_URL" ]; then 
        echolog "DEBUG: running: curl $*"
        curl --user-agent "$user_agent" "$@"
    else 
        echolog "DEBUG: running: curl -x $H3_CLI_PROXY_URL $*"
        curl -x "$H3_CLI_PROXY_URL" --user-agent "$user_agent" "$@"
    fi
}

function get_ip_address {
    local ip_addr=''
    if [[ "${OSTYPE}" == darwin* ]]; then
        # OSX
        ip_addr=$(ifconfig | grep -E "([0-9]{1,3}\.){3}[0-9]{1,3}" | grep -v '[127.0|172.17].0.1' | awk '{ print $2 }' | cut -f2 -d: | head -n1)
        RESULT=$?
    else
        # Linux
        ip_addr=$(ip addr show $(ip route | awk '/default/ { print $5 }') | grep "inet" | head -n 1 | awk '/inet/ {print $2}' | cut -d'/' -f1)
        RESULT=$?
    fi

    # command to obtain IP Address failed; default to empty value
    if [ $RESULT -ne 0 ]; then
        ip_addr=''
    fi 

    echo "$ip_addr"
    return
}

# create a backup of the profile file
# note: dup'ed in easy_install.sh
function backup_profile {
    profile_file="$1"
    if [ -e "$profile_file" ]; then
        # echo "[.] Saving backup of h3-cli profile to $profile_file.bak ..."
        cp "$profile_file" "$profile_file.bak"
    fi
}

# create empty profile if it does not exist
# note: dup'ed in easy_install.sh
function ensure_profile {
    profile_file="$1"
    if [ ! -e "$profile_file" ]; then
        profile_dir=`dirname "$profile_file"`
        mkdir -p "$profile_dir"
        touch "$profile_file"
        chmod -R 700 "$profile_dir"
    fi
}

# add var_name=var_value to profile, or update if it already exists
# note: dup'ed in easy_install.sh
function upsert_profile_var {
    profile_file="$1"
    var_name="$2"
    var_value="$3"
    if [ -z "$var_value" ]; then
        return
    fi
    # make tmpfile, remove old setting, add new setting, rm tmpfile
    mv "$profile_file" "$profile_file.tmp"
    cat "$profile_file.tmp" | grep -v "$var_name=" > "$profile_file"
    echo "$var_name=$var_value" >> "$profile_file"
    rm -f "$profile_file.tmp"
}


# Parse a gateway_redirect object and set gateway_url and extra_header globals.
# usage: parse_gateway_redirect "$gateway_redirect_json"
function parse_gateway_redirect {
    local gateway_redirect_json="$1"
    gateway_url=$(cat <<<$gateway_redirect_json | jq -r '.url // empty')
    extra_header=()
    if [ -n "$gateway_url" ]; then
        while IFS=$'\t' read -r header_key header_value; do
            if [ -n "$header_key" ] && [ -n "$header_value" ]; then
                extra_header+=(-H "$header_key: $header_value")
            fi
        done < <(cat <<<$gateway_redirect_json | jq -r '.headers // {} | to_entries[]? | [.key, .value] | @tsv')
    fi
}
