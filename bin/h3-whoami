#!/bin/bash
#
# usage: h3 whoami
#
# @help
#
# h3-whoami: Show the user account attached to the current API key.
#
# Usage:
#     h3 whoami
#
# Description:
#     Prints details about the user account associated with the API key of the
#     active profile (name, email, roles, current client account, etc.).
#

res=`h3-gql whoami`
rc=$?
if [ $rc -eq 0 ]; then
    cat <<<$res | jq .data.session_user_account
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "$res"
    fi
else
    echo "$res"
fi
exit $rc
